---
import Icon from './Icon.astro';
import { whatsappUrl, defaultWhatsappText } from '../data/site';
---

<aside class="wa-fab-wrap" aria-label="Reserva rápida">
  <a class="wa-fab" href={whatsappUrl(defaultWhatsappText)} target="_blank" rel="noopener" data-fab data-track="whatsapp" data-track-location="boton-flotante">
  <Icon name="whatsapp" size={26} />
  <span class="visually-hidden">Reservar por WhatsApp</span>
  </a>
</aside>

<style>
  .wa-fab {
    position: fixed;
    z-index: 60;
    right: max(1rem, env(safe-area-inset-right));
    bottom: calc(1rem + env(safe-area-inset-bottom));
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--wine);
    color: var(--cream);
    box-shadow:
      0 10px 30px rgb(0 0 0 / 0.35),
      0 0 0 1px rgb(255 255 255 / 0.08) inset;
    transition:
      transform 0.5s var(--ease-out),
      opacity 0.4s var(--ease-out);
  }
  .wa-fab::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 1px solid rgb(201 168 106 / 0.5);
    opacity: 0.7;
  }
  .wa-fab.is-hidden {
    transform: translate3d(0, 160%, 0);
    opacity: 0;
  }
  /* Mientras el banner de cookies está visible, el botón se aparta. */
  :global(html.js:not([data-consent])) .wa-fab {
    opacity: 0;
    pointer-events: none;
    transform: translate3d(0, 160%, 0);
  }
  @media (hover: hover) {
    .wa-fab:hover {
      transform: translate3d(0, -3px, 0);
    }
  }
  @media (min-width: 1000px) {
    .wa-fab {
      right: 1.75rem;
      bottom: 1.75rem;
      width: 60px;
      height: 60px;
    }
  }
</style>
