---
/** Lista de platos con línea de puntos y precio (o columnas copa/botella en vinos). */
import type { CartaSection } from '../data/carta';
import PriceText from './PriceText.astro';

interface Props {
  section: CartaSection;
  /** "large": secciones cortas, con los platos en grande (escritorio). */
  size?: 'normal' | 'large';
}
const { section, size = 'normal' } = Astro.props;
const cols = section.priceColumns;
---

<div class:list={['menu-list', { 'has-cols': cols, large: size === 'large' }]}>
  {
    section.groups.map((g) => (
      <div class="group">
        {g.title && <h3 class="group-title">{g.title}</h3>}
        {cols && (
          <div class="col-head" aria-hidden="true">
            <span />
            {cols.map((c) => (
              <span>{c}</span>
            ))}
          </div>
        )}
        <ul role="list" class="items">
          {g.items.map((it) => (
            <li class="item">
              <div class="item-row">
                <span class="item-name">{it.name}</span>
                {!cols && <span class="leader" aria-hidden="true" />}
                {cols ? (
                  cols.map((c) => {
                    const p = it.prices.find((x) => x.label === c);
                    return p ? (
                      <PriceText class="item-price" price={p} label={c} />
                    ) : (
                      <span class="item-price empty">
                        <span aria-hidden="true">—</span>
                        <span class="visually-hidden">{c}: no disponible</span>
                      </span>
                    );
                  })
                ) : (
                  <span class="item-price">
                    {it.prices.map((p, i) => (
                      <>
                        {i > 0 && ' / '}
                        <PriceText price={p} />
                      </>
                    ))}
                  </span>
                )}
              </div>
              {(it.description || it.note) && (
                <p class="item-meta">
                  {it.description && <span class="item-desc">{it.description}</span>}
                  {it.note && <span class="item-note">{it.note}</span>}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .menu-list {
    display: grid;
    gap: var(--space-l);
  }
  .group-title {
    margin-bottom: 0.9rem;
    line-height: 1.5;
    text-wrap: balance;
    font-family: var(--ff-sans);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brass-ink);
  }
  .items {
    display: grid;
  }
  .item {
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line-on-light);
  }
  .item:first-child {
    padding-top: 0.35rem;
  }
  .item-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .item-name {
    font-family: var(--ff-display);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.25;
    font-variant-numeric: lining-nums;
    min-width: 0;
  }
  .leader {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 1px dotted rgb(28 25 22 / 0.35);
    transform: translateY(-0.3em);
  }
  .item-price {
    flex: none;
    font-size: var(--step--1);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--wine);
  }
  .item-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.8rem;
    margin-top: 0.3rem;
    font-size: var(--step--1);
    color: var(--muted-on-light);
  }
  .item-note {
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass-ink);
    align-self: center;
  }
  /* Vinos: copa y botella en columnas */
  .has-cols .col-head,
  .has-cols .item-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.6rem 5rem;
    gap: 0.5rem;
  }
  .has-cols .col-head {
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-on-light);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line-on-light);
  }
  .has-cols .col-head span,
  .has-cols .item-price {
    text-align: right;
  }
  .item-price.empty {
    color: var(--muted-on-light);
    font-weight: 400;
  }
  @media (min-width: 1000px) {
    .large .item {
      padding-block: 1.2rem;
    }
    .large .item-name {
      font-size: var(--step-2);
    }
    .large .item-price {
      font-size: var(--step-0);
    }
    .large .item-meta {
      font-size: var(--step-0);
    }
  }
  @media (max-width: 380px) {
    .has-cols .col-head,
    .has-cols .item-row {
      grid-template-columns: minmax(0, 1fr) 4.1rem 4.6rem;
      gap: 0.35rem;
    }
  }
</style>
