---
/** Horario semanal con el día de hoy resaltado y estado «abierto/cerrado ahora» (hora de Madrid). */
import { hours, slotLabel } from '../data/site';
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['hours-wrap', className]} data-hours>
  <p class="status" data-hours-status hidden></p>
  <table class="hours">
    <caption class="visually-hidden">Horario de apertura semanal</caption>
    <tbody>
      {
        hours.map((d) => (
          <tr data-day={d.jsDay} class:list={{ closed: !d.slots.length }}>
            <th scope="row">{d.label}</th>
            <td>
              {d.slots.length
                ? d.slots.map((sl, k) => (
                    <>
                      {k > 0 && <span class="visually-hidden"> y </span>}
                      <span class="slot">{slotLabel(sl)}</span>
                    </>
                  ))
                : 'Cerrado'}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<script>
  import { closedWeekdays, SLOTS } from '../data/site';
  const DAYS = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
  const toMin = (t: string) => Number(t.slice(0, 2)) * 60 + Number(t.slice(3, 5));
  // Turnos en minutos desde las 00:00 del día de apertura (un cierre a las 01:00 cuenta como 25:00).
  const slots = SLOTS.map((s) => {
    const open = toMin(s.open);
    let close = toMin(s.close);
    if (close <= open) close += 24 * 60;
    return { open, close, label: s.close };
  });

  function madridNow() {
    const parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Madrid', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
    const day = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(get('weekday'));
    return { day, minutes: Number(get('hour')) * 60 + Number(get('minute')) };
  }
  const isOpenDay = (d: number) => !closedWeekdays.includes(d);

  function status(): { open: boolean; text: string } {
    const { day, minutes } = madridNow();
    const yesterday = (day + 6) % 7;
    // ¿Dentro de un turno de hoy o de la madrugada de un turno de ayer?
    if (isOpenDay(day)) {
      const s = slots.find((x) => minutes >= x.open && minutes < x.close);
      if (s) return { open: true, text: `Abierto ahora · cerramos a ${s.label === '01:00' ? 'la' : 'las'} ${s.label}` };
    }
    if (isOpenDay(yesterday)) {
      const s = slots.find((x) => minutes + 24 * 60 >= x.open && minutes + 24 * 60 < x.close);
      if (s) return { open: true, text: `Abierto ahora · cerramos a ${s.label === '01:00' ? 'la' : 'las'} ${s.label}` };
    }
    // Próxima apertura.
    if (isOpenDay(day)) {
      const next = slots.find((x) => minutes < x.open);
      if (next) return { open: false, text: `Cerrado ahora · abrimos hoy a las ${SLOTS[slots.indexOf(next)].open}` };
    }
    let d = day;
    do d = (d + 1) % 7;
    while (!isOpenDay(d));
    return { open: false, text: `Cerrado ahora · abrimos el ${DAYS[d]} a las ${SLOTS[0].open}` };
  }

  document.querySelectorAll<HTMLElement>('[data-hours]').forEach((root) => {
    const { day } = madridNow();
    root.querySelector(`tr[data-day="${day}"]`)?.classList.add('is-today');
    const el = root.querySelector<HTMLElement>('[data-hours-status]');
    if (!el) return;
    const st = status();
    el.textContent = st.text;
    el.classList.toggle('is-open', st.open);
    el.hidden = false;
  });
</script>

<style>
  .status {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    text-wrap: balance;
    margin-bottom: 1rem;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .status::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    transform: translateY(-1px);
    background: var(--muted-on-dark);
  }
  .status.is-open::before {
    background: #7fbf7a;
    box-shadow: 0 0 0 4px rgb(127 191 122 / 0.18);
  }
  .hours {
    width: 100%;
    max-width: 420px;
    border-collapse: collapse;
    font-size: var(--step-0);
  }
  .hours th,
  .hours td {
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line-on-dark);
    text-align: left;
    font-weight: 400;
  }
  .hours td {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .hours .slot {
    display: block;
    white-space: nowrap;
  }
  .hours .closed td {
    color: var(--muted-on-dark);
    font-style: italic;
  }
  .hours tr.is-today th,
  .hours tr.is-today td {
    color: var(--brass);
    font-weight: 600;
  }
  :global(.on-light) .hours th,
  :global(.on-light) .hours td {
    border-color: var(--line-on-light);
  }
  :global(.on-light) .hours .closed td {
    color: var(--muted-on-light);
  }
  :global(.on-light) .hours tr.is-today th,
  :global(.on-light) .hours tr.is-today td {
    color: var(--wine);
  }
</style>
