---
import Icon from './Icon.astro';
import SplitText from './SplitText.astro';
import { business, hoursSummary } from '../data/site';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Reserva _tu mesa_',
  text = 'Llámanos y te guardamos mesa. Estaremos encantados de recibirte y de recomendarte nuestros mejores platos.',
} = Astro.props;
---

<section class="cta section bg-wine grain" aria-labelledby="cta-title" data-track-zone="cta-reserva">
  <div class="container cta-inner">
    <span class="eyebrow eyebrow--center cta-eyebrow" data-reveal="fade">Reservas por teléfono</span>
    <SplitText as="h2" id="cta-title" class="display cta-title" text={title} />
    <p class="lead cta-text" data-reveal style="--d:200">{text}</p>
    <a class="cta-phone" href={business.phone.tel} data-track="phone" data-reveal style="--d:300">
      <span class="cta-phone-icon" aria-hidden="true"><Icon name="phone" size={26} /></span>
      <span class="cta-phone-number"><span class="visually-hidden">Reservar mesa llamando al </span>{business.phone.display}</span>
    </a>
    <p class="cta-hours" data-reveal="fade" style="--d:400">{hoursSummary.open}, {hoursSummary.sentence}</p>
  </div>
  <div class="cta-ember" aria-hidden="true"></div>
</section>

<style>
  .cta {
    overflow: hidden;
    text-align: center;
  }
  .cta-inner {
    display: grid;
    justify-items: center;
    gap: 1.4rem;
  }
  .cta-eyebrow {
    color: var(--bone);
  }
  .cta :global(.cta-title) {
    font-size: var(--step-5);
  }
  .cta :global(.cta-title em) {
    color: var(--bone);
  }
  .cta-text {
    max-width: 52ch;
    color: rgb(249 246 240 / 0.88);
  }
  .cta-phone {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.75rem;
    padding: 0.7rem 2.2rem 0.7rem 0.7rem;
    border-radius: 999px;
    background: var(--cream);
    color: var(--wine);
    text-decoration: none;
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.3);
    transition: transform 0.4s var(--ease-out);
  }
  .cta-phone-icon {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--wine);
    color: var(--cream);
  }
  .cta-phone-number {
    font-family: var(--ff-display);
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.2rem);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    font-variant-numeric: lining-nums;
  }
  @media (hover: hover) {
    .cta-phone:hover {
      transform: translate3d(0, -3px, 0);
    }
  }
  .cta-hours {
    font-size: var(--step--1);
    color: rgb(249 246 240 / 0.78);
  }
  .cta-ember {
    position: absolute;
    left: 50%;
    bottom: -40%;
    z-index: -1;
    width: min(900px, 140vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 130 78 / 0.32), transparent 62%);
    transform: translateX(-50%);
    /* Un único pulso de 5 s (WCAG 2.2.2: nada se mueve más de 5 s sin control). */
    animation: ember 2.5s var(--ease-in-out) 2 alternate;
  }
  @keyframes ember {
    to {
      opacity: 0.55;
      transform: translateX(-50%) scale(1.08);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-ember {
      animation: none;
    }
  }
</style>
