---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { business, whatsappUrl, defaultWhatsappText } from '../data/site';

const links = [
  { href: '/', label: 'Inicio', text: 'Vuelve a la portada' },
  { href: '/carta/', label: 'Carta y menús', text: 'Carnes, menús y vinos' },
  { href: '/nuestra-historia/', label: 'Nuestra historia', text: 'El local y la galería' },
  { href: '/contacto/', label: 'Contacto', text: 'Reservas y cómo llegar' },
];
---

<BaseLayout
  title="Página no encontrada | Restaurante Parrilla El Carnívoro"
  description="La página que buscas no existe o ha cambiado de dirección. Vuelve al inicio, consulta la carta o reserva tu mesa en El Carnívoro, Collado Villalba."
  path="/404/"
  ogImage={{ path: '/og/inicio.jpg', alt: 'Restaurante Parrilla El Carnívoro' }}
  noindex
>
  <section class="nf bg-smoke grain" aria-labelledby="nf-title">
    <div class="nf-glow" aria-hidden="true"></div>
    <div class="container nf-inner">
      <p class="nf-code" aria-hidden="true">404</p>
      <p class="eyebrow eyebrow--center">Página no encontrada</p>
      <h1 id="nf-title" class="display nf-title">Esta página se ha quedado <em>en las brasas</em></h1>
      <p class="lead nf-text">Puede que la dirección haya cambiado con la nueva web o que no exista. Te ayudamos a encontrar lo que buscas.</p>
      <ul role="list" class="nf-links" data-fab-avoid>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>
                <span class="nf-label">{l.label}</span>
                <span class="nf-sub">{l.text}</span>
                <Icon name="arrow" size={20} />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="nf-contact">
        ¿Prefieres hablar con nosotros? Llámanos al <a href={business.phone.tel} data-track="phone">{business.phone.display}</a> o escríbenos por <a href={whatsappUrl(defaultWhatsappText)} target="_blank" rel="noopener" data-track="whatsapp">WhatsApp</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: calc(var(--header-h) + var(--space-l)) var(--space-xl);
  }
  .nf-glow {
    position: absolute;
    left: 50%;
    bottom: -30%;
    z-index: -1;
    width: min(1000px, 160vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 130 78 / 0.22), rgb(155 0 14 / 0.18) 35%, transparent 65%);
    transform: translateX(-50%);
    animation: glow 2.5s var(--ease-in-out) 2 alternate;
  }
  @keyframes glow {
    to {
      opacity: 0.6;
      transform: translateX(-50%) scale(1.06);
    }
  }
  .nf-inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  .nf-code {
    font-family: var(--ff-display);
    font-size: clamp(6rem, 3rem + 18vw, 15rem);
    line-height: 0.8;
    font-variant-numeric: lining-nums;
    color: transparent;
    -webkit-text-stroke: 1px rgb(201 168 106 / 0.6);
  }
  .nf-title {
    max-width: 16ch;
  }
  .nf-text {
    color: var(--muted-on-dark);
  }
  .nf-links {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    max-width: 880px;
    margin-top: 1rem;
  }
  @media (min-width: 700px) {
    .nf-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .nf-links a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.15rem 1rem;
    padding: 1.1rem 1.4rem;
    border: 1px solid var(--line-on-dark);
    text-align: left;
    text-decoration: none;
    transition:
      border-color 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out);
  }
  .nf-links :global(svg) {
    grid-column: 2;
    grid-row: 1 / 3;
    color: var(--brass);
  }
  @media (hover: hover) {
    .nf-links a:hover {
      border-color: var(--brass);
      background: rgb(201 168 106 / 0.06);
    }
  }
  .nf-label {
    font-family: var(--ff-display);
    font-size: var(--step-2);
    line-height: 1.1;
  }
  .nf-sub {
    font-size: var(--step--1);
    color: var(--muted-on-dark);
  }
  .nf-contact {
    margin-top: 1rem;
    font-size: var(--step--1);
    color: var(--muted-on-dark);
  }
  .nf-contact a {
    color: var(--text-on-dark);
    font-weight: 600;
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .nf-glow {
      animation: none;
    }
  }
</style>
