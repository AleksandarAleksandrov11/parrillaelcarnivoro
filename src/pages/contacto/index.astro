---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import HoursTable from '../../components/HoursTable.astro';
import MapFacade from '../../components/MapFacade.astro';
import SplitText from '../../components/SplitText.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import { business, hoursSummary } from '../../data/site';
import { breadcrumbSchema } from '../../lib/schema';

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Contacto', path: '/contacto/' },
];
---

<BaseLayout
  title="Reservas y contacto | El Carnívoro, parrilla en Collado Villalba"
  description="Reserva mesa en El Carnívoro llamando al 91 501 39 83. C/ Pasaje Piscina Delfe, 3, Collado Villalba. Lunes y de jueves a domingo, de 12:00 a 17:00 y de 20:00 a 01:00."
  path="/contacto/"
  ogImage={{ path: '/og/contacto.jpg', alt: 'Entrada de Restaurante Parrilla El Carnívoro en Collado Villalba' }}
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Llámanos _y reserva_"
    kicker="Reservas y contacto"
    intro="Las reservas se hacen por teléfono. Te guardamos mesa y, si quieres un corte especial, te lo preparamos."
    photo="fachada-calle-restaurante-el-carnivoro"
    photoAlt="Entrada de El Carnívoro en el Pasaje Piscina Delfe, Collado Villalba"
    compact
  >
    <a class="hero-call" href={business.phone.tel} data-track="phone" data-track-location="cabecera-contacto" data-reveal style="--d:550">
      <span class="hc-icon" aria-hidden="true"><Icon name="phone" size={24} /></span>
      <span class="hc-number">{business.phone.display}</span>
    </a>
  </PageHero>

  <section class="section bg-paper grain contact" aria-labelledby="reserva-title">
    <div class="container container--wide contact-grid">
      <div class="call-card" id="reserva" data-reveal>
        <div class="cc-media">
          <Photo name="salon-restaurante-el-carnivoro-collado-villalba" alt="Salón de El Carnívoro con mesas de madera y luz cálida" fill sizes="(min-width: 1000px) 55vw, 100vw" />
        </div>
        <div class="cc-body">
          <span class="eyebrow">Reservas</span>
          <SplitText as="h2" id="reserva-title" class="display cc-title" text="Una llamada _y listo_" />
          <p class="cc-text">Dinos el día, la hora y cuántos vais a ser. Te confirmamos la mesa en la misma llamada.</p>
          <a class="cc-phone" href={business.phone.tel} data-track="phone" data-track-location="tarjeta-reserva">
            <span class="cc-phone-icon" aria-hidden="true"><Icon name="phone" size={22} /></span>
            <span>
              <span class="cc-phone-label">Llamar ahora</span>
              <span class="cc-phone-number">{business.phone.display}</span>
            </span>
          </a>
          <ul role="list" class="cc-tips">
            <li><Icon name="clock" size={18} /><span>Te atendemos {hoursSummary.open.toLowerCase()}, {hoursSummary.sentence}. {hoursSummary.closed}.</span></li>
            <li><Icon name="calendar" size={18} /><span>Para grupos grandes y cortes con reserva previa (chuletón madurado, tomahawk, steak ribeye o paletilla), avísanos con antelación.</span></li>
          </ul>
        </div>
      </div>

      <aside class="contact-aside" aria-labelledby="datos-title">
        <h2 id="datos-title" class="aside-title" data-reveal>Dónde estamos</h2>
        <dl class="details" data-reveal style="--d:150">
          <div>
            <dt><Icon name="pin" size={18} /> Dirección</dt>
            <dd>
              <address>{business.address.street}<br />{business.address.postalCode} {business.address.locality} ({business.address.region})</address>
              <a class="link" href={business.maps.directions} target="_blank" rel="noopener" data-track="directions">Indicaciones para llegar <Icon name="arrow" /></a>
            </dd>
          </div>
          <div>
            <dt><Icon name="clock" size={18} /> Horario</dt>
            <dd class="on-light"><HoursTable class="on-light" /></dd>
          </div>
          <div>
            <dt><Icon name="mail" size={18} /> Email</dt>
            <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
          </div>
          <div>
            <dt><Icon name="instagram" size={18} /> Instagram</dt>
            <dd><a href={business.instagram.url} target="_blank" rel="noopener">{business.instagram.handle}</a></dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section bg-smoke grain" aria-labelledby="mapa-title">
    <div class="container container--wide">
      <div class="map-head">
        <span class="eyebrow" data-reveal="fade">Ubicación</span>
        <SplitText as="h2" id="mapa-title" class="display" text="Cómo _llegar_" />
        <p class="lead muted" data-reveal style="--d:120">Estamos en el Pasaje Piscina Delfe, en el centro de Collado Villalba.</p>
      </div>
      <div class="map-box" data-reveal="fade" style="--d:150">
        <MapFacade />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-call {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    justify-self: start;
    margin-top: 0.75rem;
    padding: 0.6rem 2rem 0.6rem 0.6rem;
    border-radius: 999px;
    background: var(--wine);
    color: var(--cream);
    text-decoration: none;
    text-shadow: none;
    box-shadow: 0 18px 50px rgb(0 0 0 / 0.4);
    transition: background-color 0.3s var(--ease-out);
  }
  .hc-icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: rgb(249 246 240 / 0.15);
  }
  .hc-number {
    font-family: var(--ff-display);
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3rem);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    font-variant-numeric: lining-nums;
  }
  @media (hover: hover) {
    .hero-call:hover {
      background: var(--wine-deep);
    }
  }

  .contact-grid {
    display: grid;
    gap: var(--space-xl);
  }
  .call-card {
    position: relative;
    isolation: isolate;
    display: grid;
    overflow: hidden;
    color: var(--text-on-dark);
    background: var(--ink);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .cc-media {
    position: relative;
    min-height: 220px;
  }
  .cc-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, var(--ink));
  }
  .cc-body {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    padding: clamp(1.75rem, 4vw, 3.25rem);
  }
  .call-card :global(.cc-title) {
    font-size: var(--step-4);
  }
  .call-card :global(.cc-title em) {
    font-style: italic;
    color: var(--brass);
  }
  .cc-text {
    max-width: 44ch;
    font-size: var(--step-1);
    color: rgb(243 236 223 / 0.88);
  }
  .cc-phone {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    justify-self: start;
    padding: 0.65rem 2rem 0.65rem 0.65rem;
    border-radius: 999px;
    background: var(--cream);
    color: var(--wine);
    text-decoration: none;
    transition: transform 0.4s var(--ease-out);
  }
  .cc-phone > span:last-child {
    display: grid;
    line-height: 1.1;
  }
  .cc-phone-icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--wine);
    color: var(--cream);
  }
  .cc-phone-label {
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass-ink);
  }
  .cc-phone-number {
    font-family: var(--ff-display);
    font-size: clamp(1.9rem, 1.4rem + 1.8vw, 2.8rem);
    font-weight: 600;
    white-space: nowrap;
    font-variant-numeric: lining-nums;
  }
  @media (hover: hover) {
    .cc-phone:hover {
      transform: translate3d(0, -3px, 0);
    }
  }
  .cc-tips {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-on-dark);
    font-size: var(--step--1);
    color: var(--muted-on-dark);
  }
  .cc-tips li {
    display: flex;
    gap: 0.75rem;
  }
  .cc-tips :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--brass);
  }
  .contact-aside {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }
  .aside-title {
    font-size: var(--step-3);
  }
  .details {
    display: grid;
    gap: 1.5rem;
  }
  .details > div {
    display: grid;
    gap: 0.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line-on-light);
  }
  .details > div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .details :global(.hours) {
    max-width: none;
  }
  .details dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass-ink);
  }
  .details dd {
    display: grid;
    gap: 0.6rem;
  }
  .details address {
    font-style: normal;
  }
  .details a:not(.link) {
    color: var(--wine);
    font-weight: 600;
    word-break: break-word;
  }
  @media (min-width: 1000px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
    .call-card {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      min-height: 560px;
    }
    .cc-media::after {
      background: linear-gradient(90deg, transparent 50%, var(--ink));
    }
    .cc-body {
      align-content: center;
    }
  }
  .map-head {
    display: grid;
    gap: 1rem;
    max-width: 760px;
    margin-bottom: var(--space-l);
  }
  .map-box {
    height: clamp(420px, 60vh, 620px);
  }
</style>
