---
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import Hero from '../components/Hero.astro';
import Photo from '../components/Photo.astro';
import SplitText from '../components/SplitText.astro';
import Icon from '../components/Icon.astro';
import Gallery from '../components/Gallery.astro';
import HoursTable from '../components/HoursTable.astro';
import MapFacade from '../components/MapFacade.astro';
import ReserveCta from '../components/ReserveCta.astro';
import ReviewCard from '../components/ReviewCard.astro';
import PriceText from '../components/PriceText.astro';
import { heroPoster, PORTRAIT_MQ } from '../lib/hero';
import { restaurantSchema, websiteSchema, abs } from '../lib/schema';
import { euros, findItem } from '../lib/format';
import { getSection } from '../data/carta';
import { getImage } from 'astro:assets';
import { photo } from '../data/photos';
import { gallery } from '../data/gallery';
import { homeReviews, googleRating } from '../data/reviews';
import { business } from '../data/site';
import type { PhotoName } from '../data/photos';

const poster = await heroPoster();

// TODO: confirmar con el cliente que cada foto corresponde al corte indicado (nombres de archivo de la web anterior).
const meatDefs: { name: string; photo: PhotoName; alt: string; position?: string }[] = [
  { name: 'Chuletón', photo: 'chuleton-parrilla-carbon-el-carnivoro', alt: 'Chuletón a la parrilla de carbón trinchado sobre pizarra' },
  { name: 'Entraña', photo: 'entrana-parrilla-el-carnivoro', alt: 'Entraña a la brasa cortada en lonchas, jugosa por dentro' },
  { name: 'T-Bone', photo: 't-bone-brasa-el-carnivoro', alt: 'T-Bone a la brasa servido sobre pizarra' },
  { name: 'Tomahawk', photo: 'chuleton-tomahawk-el-carnivoro', alt: 'Gran chuletón con hueso a la brasa con patatas y verduras', position: 'center 14%' },
];
const meats = meatDefs.map((m) => ({ ...m, item: findItem('carnes', m.name) }));

const cenas = getSection('menu-cenas');
if (cenas.kind !== 'menu') throw new Error('menu-cenas');
const cenasMenu = cenas.menus[0];

const featured = gallery.filter((g) => g.featured);

// Imágenes del schema: fotos reales del restaurante, sin textos superpuestos (1200 px, JPEG).
const schemaImages = await Promise.all(
  (
    [
      'salon-restaurante-el-carnivoro-collado-villalba',
      'fachada-terraza-exterior-el-carnivoro',
      'terraza-cubierta-el-carnivoro',
      'chuleton-parrilla-carbon-el-carnivoro',
    ] as const
  ).map(async (n) => abs((await getImage({ src: await photo(n), width: 1200, format: 'jpg' })).src)),
);
const schema = [restaurantSchema(schemaImages), websiteSchema()];
---

<BaseLayout
  title="Restaurante parrilla en Collado Villalba | El Carnívoro"
  description="Carne a la brasa de carbón en Collado Villalba, sierra de Madrid: chuletón, entraña, T-Bone, menú de cenas y fines de semana y gran terraza. Reservas: 91 501 39 83."
  path="/"
  ogImage={{ path: '/og/inicio.jpg', alt: 'Carne a la parrilla de carbón en Restaurante Parrilla El Carnívoro, Collado Villalba' }}
  schema={schema}
  intro
>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/avif" imagesrcset={poster.portAvif} imagesizes="100vw" media={PORTRAIT_MQ} fetchpriority="high" />
    <link rel="preload" as="image" type="image/avif" imagesrcset={poster.landAvif} imagesizes="100vw" media={`not all and ${PORTRAIT_MQ}`} fetchpriority="high" />
  </Fragment>

  <Intro />
  <Hero />

  {/* Introducción --------------------------------------------------------*/}
  <section id="descubre" class="section intro-sec bg-paper grain" aria-labelledby="descubre-title">
    <div class="container intro-grid">
      <div class="intro-copy">
        <span class="eyebrow" data-reveal="fade">Collado Villalba · Sierra de Madrid</span>
        <SplitText as="h2" id="descubre-title" class="display" text="La mejor carne a la parrilla _de la sierra de Madrid_" />
        <div class="stack intro-text" style="--flow:1.1em">
          <p class="lead" data-reveal style="--d:150">
            Si buscas dónde comer buena carne en la sierra de Madrid, has llegado al lugar indicado. En El Carnívoro seleccionamos los mejores cortes y los cocinamos sobre brasa de carbón para que cada bocado conserve todo su jugo y el sabor más intenso.
          </p>
          <p data-reveal style="--d:250">Una experiencia gastronómica para disfrutar sin prisas, con buena compañía y buen vino, en nuestro restaurante de Collado Villalba.</p>
        </div>
        <ul class="facts" role="list">
          <li data-reveal style="--d:100">
            <span class="fact-title">Parrilla de carbón</span>
            <span class="fact-text">Brasa viva para cada corte</span>
          </li>
          <li data-reveal style="--d:200">
            <span class="fact-title">Salón y gran terraza</span>
            <span class="fact-text">Dentro o al aire de la sierra</span>
          </li>
          <li data-reveal style="--d:300">
            <span class="fact-title">De 10:00 a&nbsp;01:00</span>
            <span class="fact-text">Del aperitivo a la sobremesa</span>
          </li>
        </ul>
      </div>
      <div class="intro-media" data-parallax="0.06">
        <Photo
          name="carnes-brasa-pizarra-el-carnivoro"
          alt="Carnes a la brasa recién cortadas servidas sobre tablas de pizarra en El Carnívoro"
          sizes="(min-width: 1000px) 45vw, 90vw"
          ratio="4 / 5"
          reveal="mask"
          curtain="#2b2621"
        />
      </div>
    </div>
  </section>

  {/* Carnes ----------------------------------------------------------------*/}
  <section id="carnes" class="section bg-coal grain meats" aria-labelledby="carnes-title">
    <div class="container container--wide">
      <div class="sec-head">
        <span class="eyebrow" data-reveal="fade">Parrilla de carbón</span>
        <SplitText as="h2" id="carnes-title" class="display" text="Cortes _con carácter_" />
      </div>

      <div class="meat-mosaic">
        {
          meats.map((m, i) => (
            <figure class:list={['meat', `meat--${i + 1}`]} data-reveal style={`--d:${i * 120}`}>
              <Photo name={m.photo} alt={m.alt} fill position={m.position} sizes={i === 0 ? '(min-width: 1000px) 50vw, 100vw' : '(min-width: 1000px) 25vw, 50vw'} class="meat-photo" />
              <figcaption class="meat-cap">
                <span class="meat-name">{m.name}</span>
                <PriceText class="meat-price" price={m.item.prices[0]} />
              </figcaption>
            </figure>
          ))
        }
      </div>

      <a class="link meats-more" href="/carta/#carnes" data-reveal="fade">Todas las carnes de la carta <Icon name="arrow" /></a>
    </div>
  </section>

  {/* Salón y terraza -------------------------------------------------------*/}
  <section class="section bg-cream grain spaces" aria-labelledby="espacios-title">
    <div class="container container--wide">
      <div class="spaces-head">
        <div>
          <span class="eyebrow" data-reveal="fade">Un restaurante con encanto</span>
          <SplitText as="h2" id="espacios-title" class="display" text="Salón _y terraza_" />
        </div>
      </div>
      <div class="spaces-pair">
        <figure class="space" data-reveal style="--d:100">
          <Photo
            name="salon-restaurante-el-carnivoro-collado-villalba"
            alt="Salón interior de El Carnívoro con mesas de madera, ladrillo visto y lámparas de luz cálida"
            sizes="(min-width: 800px) 46vw, 100vw"
            ratio="4 / 3"
          />
          <figcaption>El salón</figcaption>
        </figure>
        <figure class="space" data-reveal style="--d:220">
          <Photo
            name="terraza-cubierta-el-carnivoro"
            alt="Gran terraza cubierta con pérgola de madera y mural de paisaje de sierra"
            sizes="(min-width: 800px) 46vw, 100vw"
            ratio="4 / 3"
          />
          <figcaption>La terraza</figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* Menú de cenas y fines de semana ------------------------------------*/}
  <section class="section bg-wood grain dinner" aria-labelledby="cenas-title">
    <div class="container container--wide dinner-grid">
      <div class="dinner-media" data-reveal="fade">
        <Photo
          name="chuletillas-cordero-el-carnivoro"
          alt="Chuletillas de cordero a la brasa sobre pizarra con romero"
          sizes="(min-width: 1000px) 50vw, 100vw"
          ratio="4 / 3"
        />
      </div>
      <div class="dinner-card" data-reveal style="--d:120">
        <span class="eyebrow eyebrow--center">{cenas.kicker}</span>
        <SplitText as="h2" id="cenas-title" class="display dinner-title" text="Menú cenas _y fines de semana_" />
        <ul role="list" class="dinner-courses">
          {
            cenasMenu.courses.map((c) => (
              <li>
                <span class="dc-title">{c.title}</span>
                <span class="dc-text">{c.options.length} a elegir</span>
              </li>
            ))
          }
        </ul>
        <p class="dinner-includes">Con pan, una bebida y café o chupito incluidos.</p>
        <p class="dinner-price">
          <span class="dp-amount">{euros(cenasMenu.price.amount)}</span>
          <span class="dp-per">por persona</span>
        </p>
        <a class="link" href="/carta/#menu-cenas">Ver el menú completo <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  {/* Galería destacada -----------------------------------------------------*/}
  <section class="section bg-ink grain" aria-labelledby="galeria-title">
    <div class="container container--wide">
      <div class="sec-head sec-head--split">
        <div>
          <span class="eyebrow" data-reveal="fade">Galería</span>
          <SplitText as="h2" id="galeria-title" class="display" text="El fuego, _la mesa,_ la sierra" />
        </div>
        <a class="link" href="/galeria/" data-reveal="fade">Todas las fotos <Icon name="arrow" /></a>
      </div>
      <Gallery items={featured} label="Selección de fotos de El Carnívoro" layout="featured" />
    </div>
  </section>

  {/* Opiniones -------------------------------------------------------------*/}
  <section class="section bg-bone grain reviews" aria-labelledby="opiniones-title">
    <div class="container container--wide">
      <div class="sec-head sec-head--center">
        <span class="eyebrow eyebrow--center" data-reveal="fade">Opiniones</span>
        <SplitText as="h2" id="opiniones-title" class="display" text="Lo que dicen _nuestros clientes_" />
        <p class="rating-line" data-reveal style="--d:150">
          <span class="rating-stars" aria-hidden="true">★</span>
          <span><strong>{googleRating.score}</strong> de 5 en Google, con {googleRating.count} reseñas</span>
        </p>
      </div>
      <ul class="review-grid" role="list">
        {
          homeReviews.map((r, i) => (
            <li data-reveal style={`--d:${i * 140}`}>
              <ReviewCard review={r} />
            </li>
          ))
        }
      </ul>
      <div class="reviews-more" data-reveal="fade">
        <a class="btn btn--dark" href={business.maps.reviews} target="_blank" rel="noopener">Ver todas las reseñas en Google</a>
        <a class="link" href="/galeria/#opiniones">Más opiniones <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  {/* Horario y ubicación ---------------------------------------------------*/}
  <section id="visitanos" class="section bg-smoke grain visit" aria-labelledby="visitanos-title">
    <div class="container container--wide visit-grid">
      <div class="visit-copy">
        <span class="eyebrow" data-reveal="fade">Ven a visitarnos</span>
        <SplitText as="h2" id="visitanos-title" class="display" text="Horario _y ubicación_" />
        <address class="visit-address" data-reveal>
          <Icon name="pin" size={20} />
          <span>{business.address.oneLine}</span>
        </address>
        <div data-reveal style="--d:100">
          <HoursTable />
        </div>
        <div class="visit-actions" data-reveal style="--d:200">
          <a class="btn btn--primary" href={business.phone.tel} data-track="phone">
            <Icon name="phone" />
            Reservar por teléfono
          </a>
        </div>
      </div>
      <div class="visit-map" data-reveal="fade" style="--d:150">
        <MapFacade />
      </div>
    </div>
  </section>

  <ReserveCta />
</BaseLayout>

<style>
  .sec-head {
    display: grid;
    gap: 1.1rem;
    max-width: 760px;
    margin-bottom: var(--space-xl);
  }
  .sec-head--center {
    margin-inline: auto;
    justify-items: center;
    text-align: center;
  }
  .sec-head--split {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .sec-head--split > div {
    display: grid;
    gap: 1.1rem;
  }

  /* Introducción */
  .intro-grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }
  .intro-copy {
    display: grid;
    gap: 1.4rem;
  }
  .intro-text {
    max-width: 56ch;
  }
  .facts {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-on-light);
  }
  .facts li {
    display: grid;
    gap: 0.15rem;
  }
  .fact-title {
    font-family: var(--ff-display);
    font-size: var(--step-2);
    line-height: 1.1;
    color: var(--wine);
    text-wrap: balance;
  }
  .fact-text {
    font-size: var(--step--1);
    color: var(--muted-on-light);
  }
  .intro-media {
    box-shadow: 0 40px 80px rgb(28 25 22 / 0.18);
  }
  @media (min-width: 640px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) and (max-width: 1279px) {
    .facts {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    .facts li {
      grid-template-columns: auto 1fr;
      align-items: baseline;
      gap: 1rem;
    }
  }
  @media (min-width: 1000px) {
    .intro-grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  /* Carnes: mosaico de fotos */
  .meats .sec-head {
    margin-bottom: var(--space-l);
  }
  .meats-more {
    margin-top: var(--space-m);
  }
  .meat-mosaic {
    display: grid;
    gap: clamp(0.6rem, 1.2vw, 1rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: clamp(180px, 42vw, 300px);
  }
  .meat {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .meat--1 {
    grid-column: 1 / -1;
    grid-row: span 2;
  }
  .meat--4 {
    grid-column: 1 / -1;
  }
  .meat :global(.meat-photo) {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .meat :global(.meat-photo img) {
    transition: transform 1.4s var(--ease-out);
  }
  @media (hover: hover) {
    .meat:hover :global(.meat-photo img) {
      transform: scale(1.04);
    }
  }
  .meat::after {
    content: '';
    position: absolute;
    inset: 40% 0 0;
    z-index: -1;
    background: linear-gradient(180deg, transparent, rgb(11 10 9 / 0.88));
  }
  .meat-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: clamp(0.9rem, 2vw, 1.6rem);
    text-shadow: 0 2px 14px rgb(0 0 0 / 0.5);
  }
  .meat-name {
    font-family: var(--ff-display);
    font-size: var(--step-3);
    line-height: 1;
  }
  .meat--1 .meat-name {
    font-size: var(--step-4);
  }
  .meat-cap :global(.meat-price) {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--brass);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 1000px) {
    .meat-mosaic {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: clamp(220px, 19vw, 330px);
    }
    .meat--1 {
      grid-column: 1 / 3;
      grid-row: 1 / 3;
    }
    .meat--4 {
      grid-column: 3 / 5;
    }
  }

  /* Salón y terraza */
  .spaces-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: var(--space-l);
  }
  .spaces-head > div {
    display: grid;
    gap: 1.1rem;
  }
  .spaces-head .lead {
    max-width: 52ch;
  }
  .spaces-pair {
    display: grid;
    gap: clamp(1rem, 2.5vw, 2rem);
  }
  .space figcaption {
    margin-top: 0.85rem;
    font-size: var(--step--2);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted-on-light);
  }
  @media (min-width: 800px) {
    .spaces-pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .spaces-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      gap: var(--space-l);
    }
  }

  /* Menú de cenas */
  .dinner-grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }
  .dinner-card {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 3rem);
    text-align: center;
    border: 1px solid rgb(201 168 106 / 0.32);
    background: linear-gradient(180deg, rgb(28 25 22 / 0.78), rgb(11 10 9 / 0.88));
  }
  .dinner-card::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid rgb(201 168 106 / 0.12);
    pointer-events: none;
  }
  .dinner-card :global(.dinner-title) {
    font-size: var(--step-4);
    text-wrap: balance;
  }
  .dinner-card :global(.dinner-title em) {
    font-style: italic;
    color: var(--brass);
  }
  .dinner-courses {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem clamp(1.5rem, 4vw, 3rem);
    padding-block: 1.25rem;
    border-block: 1px solid rgb(201 168 106 / 0.3);
  }
  .dinner-courses li {
    display: grid;
    gap: 0.2rem;
  }
  .dc-title {
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .dc-text {
    font-family: var(--ff-display);
    font-size: var(--step-1);
  }
  .dinner-includes {
    max-width: 40ch;
    color: var(--muted-on-dark);
  }
  .dinner-price {
    display: grid;
    place-items: center;
    min-width: 180px;
    padding: 0.95rem 2rem;
    border-radius: 50%;
    background: var(--wine);
    color: var(--cream);
    box-shadow: 0 14px 40px rgb(155 0 14 / 0.35);
  }
  .dp-amount {
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .dp-per {
    font-size: var(--step--2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  @media (min-width: 1000px) {
    .dinner-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  /* Opiniones */
  .review-grid {
    display: grid;
    gap: clamp(1rem, 2vw, 2rem);
  }
  @media (min-width: 900px) {
    .review-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .rating-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 0.8rem;
    font-size: var(--step-0);
    color: var(--muted-on-light);
  }
  .rating-line strong {
    font-size: var(--step-1);
    color: var(--text-on-light);
  }
  .rating-stars {
    color: var(--brass-ink);
    letter-spacing: 0.12em;
  }
  .reviews-more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 2rem;
    margin-top: var(--space-l);
  }

  /* Visítanos */
  .visit-grid {
    display: grid;
    gap: var(--space-l);
  }
  .visit-copy {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .visit-address {
    display: flex;
    gap: 0.75rem;
    font-style: normal;
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .visit-address :global(svg) {
    flex: none;
    margin-top: 0.3rem;
    color: var(--brass);
  }
  .visit-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .visit-map {
    min-height: 440px;
  }
  @media (min-width: 1000px) {
    .visit-grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: stretch;
    }
  }
</style>
